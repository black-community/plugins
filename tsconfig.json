{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@black/plugin": [
        "./sdk/black-plugin.d.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "plugins",
    "shared",
    "sdk",
    "tests"
  ]
}
